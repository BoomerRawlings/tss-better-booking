{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tss-better-booking",
  "main": "workers/booking/src/index.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/booking/api/*"] },
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [
    { "name": "SESSIONS", "class_name": "BookingSession" },
    { "name": "QUOTA", "class_name": "BookingQuota" }
  ] },
  "migrations": [{ "tag": "booking-v1", "new_sqlite_classes": ["BookingSession", "BookingQuota"] }],
  "vars": {
    "APP_ORIGIN": "https://booking.example.org",
    "PROBE_ONLY": "true",
    "DIRECT_BOOKING_ENABLED": "false",
    "MAX_BROWSER_SESSIONS": "1",
    "MAX_SESSION_MINUTES": "15",
    "MONTHLY_BROWSER_MINUTES": "90"
  },
  "observability": { "enabled": false }
}
